      "toolchainFile": "E:/SDK/Android/ndk/29.0.14206865/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_ANDROID_NDK": "E:/SDK/Android/ndk/29.0.14206865",
        "CMAKE_ANDROID_STL_TYPE": "c++_shared",
        "ANDROID_PLATFORM": "android-26",
        "CMAKE_CXX_FLAGS": "-I\"E:/SDK/Android/ndk/29.0.14206865/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include\"",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
        //"CMAKE_C_COMPILER": "E:/SDK/Android/ndk/29.0.14206865/toolchains/llvm/prebuilt/windows-x86_64/bin/clang.exe",
        //"CMAKE_CXX_COMPILER": "E:/SDK/Android/ndk/29.0.14206865/toolchains/llvm/prebuilt/windows-x86_64/bin/clang++.exe"
